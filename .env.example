# ============================================================================
# SM SPORT CENTER - Environment Variables
# Isi nilai-nilai berikut di Vercel Project Settings > Environment Variables
# (Jangan commit file .env asli yang berisi nilai sungguhan ke Git)
# ============================================================================

# --- Database MySQL (gunakan MySQL hosting, mis. PlanetScale/Railway/Aiven/Clever Cloud) ---
# localhost TIDAK BISA dipakai karena Vercel adalah server cloud, bukan komputer Anda.
DB_HOST=your-mysql-host.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=sm_sport_center
DB_SSL=true

# Alternatif: gunakan 1 connection string saja (lebih simpel), contoh PlanetScale:
# DATABASE_URL=mysql://user:pass@host/dbname?ssl={"rejectUnauthorized":true}

# --- Auth (session pakai JWT + cookie, ganti dengan string acak & rahasia) ---
JWT_SECRET=ganti_dengan_string_acak_panjang_dan_rahasia

# --- Midtrans Sandbox (ganti dengan key produksi saat go-live) ---
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_IS_PRODUCTION=false
